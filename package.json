{
  "name": "uia-demo",
  "version": "0.1.0",
  "private": true,
  "description": "Windows UIA text-selection extraction PoC (Chromium) — Electron + napi-rs",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite dev --noWatch",
