  "dependencies": {
    "uia-probe": "workspace:*"
  },
  "devDependencies": {
    "@napi-rs/cli": "^2.18.4",
    "@types/node": "^26.5.1",
    "electron": "^37.2.0",
    "electron-vite": "^3.1.0",
    "typescript": "^5.5.4",
    "vite": "^6.1.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "esbuild"
    ]
  }
